# Copy to .env (git-ignored) and fill in. Used by `npm run example:ai`.

# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# The agent's WhatsApp number, international format. When set, the device is
# linked with a pairing code instead of a QR.
WA_AGENT_PHONE=

# Comma-separated numbers allowed to use the agent.
WA_AUTHORIZED_NUMBERS=

# Optional: run your own agent instead of the demo one.
# AI_MODEL=anthropic/claude-opus-4.8
# AI_REASONING=low
# AGENT_INSTRUCTIONS=You are ...   (replaces the demo instructions and tools)
